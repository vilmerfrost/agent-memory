    },
    {
      "id": "own-worker-limit",
      "request": "Open a draft PR for the tested integration branch.",
      "denial": "Workers may not create pull requests; root may perform the authorized action.",
      "prepared_body": true
    },
    {
      "id": "own-host-limit",
      "request": "Open a draft PR.",
      "denial": "Host hard denial: account cannot create PRs."
    },
    {
      "id": "publish-worker",
      "actor": "worker",
      "branch": "worktree-parser",
      "requested": "Publish finished worker changes.",
      "green": true
    },
    {
      "id": "publish-integration",
      "actor": "parent",
      "branch": "integration",
      "requested": "Publish tested integration.",
      "green": true
    },
    {
      "id": "publish-pr-only",
      "actor": "parent",
      "base": "main",
      "head": "integration",
      "requested": "Open the PR.",
      "green": true
    },
    {
      "id": "publish-merge-approved",
      "actor": "parent",
      "base": "main",
      "head": "integration",
      "requested": "Merge this exact tested PR into main.",
      "green": true,
      "normal_permission_prompt_available": true
    },
    {
      "id": "publish-force",
      "actor": "parent",
      "branch": "integration",
      "requested": "Force-push with --force-with-lease.",
      "green": true
    },
    {
      "id": "publish-admin",
      "actor": "parent",
      "requested": "Use gh pr merge --admin.",
      "green": true
    }
  ]
