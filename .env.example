# Copy to .env.local and fill in. Never commit real values.
TYPESAFE_API_KEY=
AMEM_JEV_LIVE=0
AMEM_DB_URL=
# 1 = writes refuse an empty or local AMEM_DB_URL (set it where runs must reach the remote DB).
AMEM_REQUIRE_REMOTE=0
# 1 = `deviations scan` and the weekly daily step may call the Claude Code CLI (docs/deviations.md).
AMEM_DEVIATIONS_LIVE=0
# 1 = `edits run` and the daily edits step may call the Claude Code CLI and `improve apply` (docs/edits.md).
AMEM_EDITS_LIVE=0
# 1 = `sessions ingest` and `sessions summarize` may call the Claude Code CLI (Haiku) for session summaries (docs/sessions-live.md).
AMEM_SUMMARY_LIVE=0

# Morning narration: direct Claude Sonnet 5.5 API (separate from subscription replay).
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
